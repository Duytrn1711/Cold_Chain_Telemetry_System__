PORT=3000

# Neon pooled connection used by the app. Neon CLI writes this to the root .env.local.
# Use DATABASE_URL_UNPOOLED for schema migrations, not normal app traffic.
DATABASE_URL=

# Local fallback when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=cold_chain_telemetry

# Generate a unique secret of at least 32 characters for each deployment.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Configure a different shared secret on the Agri sender.
AGRI_WEBHOOK_SECRET=replace_with_a_unique_shared_integration_secret

# Optional pull integration. When configured, Cold Chain polls Agri-Audit for batches.
AGRI_AUDIT_API_URL=https://agri-audit-chain-backend.onrender.com
AGRI_AUDIT_ADMIN_IDENTIFIER=
AGRI_AUDIT_ADMIN_PASSWORD=
AGRI_AUDIT_POLL_INTERVAL_MS=5000

# Used only by `npm run bootstrap-admin` on a new database.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_initial_password
BOOTSTRAP_ADMIN_NAME=System Administrator
